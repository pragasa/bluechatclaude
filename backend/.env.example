# BlueChat Backend Environment Variables

# Node Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=mongodb://localhost:27017/bluechat
# Alternative for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/bluechat

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this
JWT_EXPIRY=7d

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth (GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Redis (for caching & sessions)
REDIS_URL=redis://localhost:6379

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=bluechat-files
AWS_REGION=us-east-1
AWS_S3_URL=https://s3.amazonaws.com/bluechat-files

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@bluechat.app

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# WebSocket Configuration
WS_URL=ws://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_FILE_SHARING=true
ENABLE_GROUP_CHATS=true

# Session
SESSION_SECRET=your_session_secret_key_change_this
SESSION_TIMEOUT=86400000

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=
